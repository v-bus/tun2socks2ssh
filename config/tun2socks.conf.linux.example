# tun2socks Linux example configuration
# Copy to /usr/local/etc/tun2socks.conf and edit.

# Physical interface that reaches your SSH server (see: ip route show default).
REAL_IF="wlan0"

SSH_USER="user"
SSH_HOST="123.123.123.123"
SSH_IP="123.123.123.123"
SSH_PORT="22"

SSH_IDENTITY_FILE="/home/YOUR_USER/.ssh/id_ed25519"
SSH_IDENTITIES_ONLY="yes"
TUN_MTU="1400"
SSH_KNOWN_HOSTS_FILE="/usr/local/etc/tun2socks_known_hosts"
SSH_STRICT_HOST_KEY_CHECKING="yes"

SSH_TUNNELS_COUNT="10"
SOCKS_HOST="127.0.0.1"
SOCKS_BASE_PORT="1080"

SOCKS_BALANCER_PORT="1090"
GOST_STRATEGY="round"
GOST_MAX_FAILS="1"
GOST_FAIL_TIMEOUT="10s"

# Linux tun device name (must match tun2socks -device).
TUN_IF="tun0"
TUN_GW="198.18.0.1"

ROUTE_MODE="default"

CHECK_INTERVAL="3"
LOG_FILE="/var/log/tun2socks-routeguard.log"

RUNTIME_DIR="/var/run/tun2socks"

# DNS (optional). Uses systemd-resolved resolvectl on the REAL_IF link.
DNS_MANAGE="no"
DNS_SERVERS=("127.0.0.1")
DNS_BACKUP_FILE="$RUNTIME_DIR/dns-backup.txt"
