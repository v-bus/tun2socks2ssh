<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>local.tun2socks.routeguard</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/sbin/tun2socks-routeguard.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/tun2socks-routeguard.out.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/tun2socks-routeguard.err.log</string>
  </dict>
</plist>
